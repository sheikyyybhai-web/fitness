# ==============================================================================
# FITNESS METRIC: Environment Variables Configuration
# Copy this file to .env.local and enter your Supabase project credentials.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anonymous Client Key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# IMPORTANT SECURITY WARNING:
# NEVER expose the Supabase SERVICE_ROLE_KEY in frontend code or client-side bundles!
# The service-role key bypasses Row-Level Security (RLS) and must strictly remain on secure server backends.
